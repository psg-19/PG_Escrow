# ---------------------------------------------------------------- AI judge
# Get a key from https://aistudio.google.com/apikey — it starts with "AIza".
# A key starting "AQ." is an ephemeral Live-API token and will not work.
#
# Check it with:  npm run judge:check
#
# Gemini is the default provider; set this and the adjudicator goes live.
# Without it the panel falls back to a scripted stub that labels itself in the
# audit record, so a rehearsal can never be mistaken for a real verdict.
GEMINI_API_KEY=

# Optional model overrides.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_SCREENING_MODEL=gemini-flash-lite-latest

# Force a provider: gemini | anthropic | scripted. Otherwise chosen from
# whichever key is present.
JUDGE_PROVIDER=

# Only needed if you set JUDGE_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# ------------------------------------------------------- Google sign-in
# From your Supabase project: Settings -> API.
# Leave blank and the Google button simply does not render; email/password
# sign-in keeps working either way.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ------------------------------------------------------------------- chain
# localhost for development. For a deployment see DEPLOY.md.
CHAIN=localhost
RPC_URL=http://127.0.0.1:8545

# Required on any non-local chain — the code refuses to start without them,
# because the built-in fallbacks are publicly known Hardhat development keys.
#   PLATFORM_PRIVATE_KEY  deploys contracts, pays gas, funds new accounts
#   ORACLE_PRIVATE_KEY    signs verdicts that move deposits — keep separate
PLATFORM_PRIVATE_KEY=
ORACLE_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=

# ---------------------------------------------------------------- database
# Unset = a local SQLite file, which is wiped on every container restart.
# Hosted libsql (Turso) needs both of these.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ----------------------------------------------------------------- storage
# Unset = local disk, also ephemeral. Photographs must outlive the container
# or the Merkle roots on-chain point at files that no longer exist.
SUPABASE_STORAGE_BUCKET=
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------- servers
# Where the web app reaches the API, server-side. The browser never calls this
# directly — Next proxies /api/* to it, so every browser request is same-origin
# and the session cookie works. Pointing the browser at a second origin is what
# breaks login.
API_URL=http://127.0.0.1:4000

# Only used by the API's own CORS, for tools that call it directly.
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------ AWS (see AWS_SETUP.md)
# KMS auto-enables when AWS_KMS_KEY_ID is set. Use kms in deployments.
# local plaintext mode is allowed ONLY for non-production localhost development.
WALLET_KEY_PROTECTION=local
AWS_REGION=ap-south-1
# Use the KeyArn output from infra/aws-security.json, not an asymmetric key.
AWS_KMS_KEY_ID=
# Set to move NEW photo uploads to private S3 with SSE-KMS.
AWS_S3_BUCKET=
# Optional separate photo key; defaults to AWS_KMS_KEY_ID.
AWS_S3_KMS_KEY_ID=
# Use the SDK credential chain: AWS_PROFILE locally or an IAM role on AWS.
# Never put credentials in NEXT_PUBLIC_* variables or commit them to Git.
# AWS_PROFILE=pg-buildathon
# For temporary credentials supplied by your host, set all three there:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
